{
  "name": "@emeraldpi/openclaw-model-prompts",
  "version": "0.1.0",
  "description": "OpenClaw plugin: append or prepend system-prompt text for specific models or providers",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  },
  "peerDependencies": {
    "openclaw": ">=2026.11.2"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.11.2",
      "minGatewayVersion": "2026.11.2"
    },
    "build": {
      "openclawVersion": "2026.11.2",
      "pluginSdkVersion": "2026.11.2"
    }
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  }
}
